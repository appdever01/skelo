{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "allowJs": true, "checkJs": false, "declaration": true,
    "esModuleInterop": true, "verbatimModuleSyntax": true
  },
  "include": ["src/svelte/**/*.svelte", "src/svelte/**/*.ts", "examples/svelte/**/*.svelte"]
}
